{
  "name": "image-create",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "smoke": "DATA_DIR=.smoke-data tsx scripts/smoke.ts",
    "test": "rm -rf .test-data && DATA_DIR=.test-data IMAGE_CREATE_CONFIG=.test-data/config.json tsx --test scripts/pricing.test.ts scripts/request.test.ts scripts/validate.test.ts scripts/credentials.test.ts scripts/store.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "better-sqlite3": "^12",
    "drizzle-orm": "^0.44",
    "next": "^15.5",
    "react": "^19.2",
    "react-dom": "^19.2",
    "sharp": "^0.34",
    "undici": "^8.9.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5.9"
  }
}
