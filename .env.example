# Copy to .env and fill in. .env is git-ignored and read ONLY server-side.
# API keys / base URLs can also be set via in-app Settings, which writes
# ~/.image-create/config.json (0600) and overrides these per-field (SPEC §5).

# --- OpenAI ---
OPENAI_API_KEY=
# Optional: point at a proxy / relay / custom gateway. Include the version path
# your endpoint expects (default: https://api.openai.com/v1).
# OPENAI_BASE_URL=https://your-proxy.example.com/v1

# --- Google Gemini ---
GOOGLE_API_KEY=
# Optional: custom Gemini endpoint.
# GOOGLE_BASE_URL=https://your-proxy.example.com

# Optional: override where the SQLite DB + generated images live (default ./data)
# DATA_DIR=./data

# NOTE: OpenAI's Organization Verification gate for gpt-image models applies ONLY
# when calling the official api.openai.com endpoint directly. Via a custom
# OPENAI_BASE_URL you authenticate to that gateway, so it does not apply.
